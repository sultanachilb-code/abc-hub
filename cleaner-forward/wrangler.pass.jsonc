{
  /* Cleaner QR old link: abcv-loading-area-access — see cleaner-forward/worker.js */
  "name": "abcv-loading-area-access",
  "main": "worker.js",
  "compatibility_date": "2026-07-09",
  "assets": { "directory": "./pass", "binding": "ASSETS", "run_worker_first": true },
  "services": [ { "binding": "HUB", "service": "operations-hub" } ],
  "vars": { "KIND": "pass" }
}
