{
  "name": "operations-hub",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hub-db", "database_id": "e7ae150f-de70-4376-a15b-65390159f65c" },
    /* ABCON reads these READ-ONLY (modules/extdb.js — only SELECT queries). Each belongs to its own system.
       abc-snaglist and abc-audit-db are on another Cloudflare account, so they cannot be bound here. */
    { "binding": "INC_DB", "database_name": "abc-incidents", "database_id": "61054354-17c3-4dfa-8658-be538e364003" },
    { "binding": "RR_DB", "database_name": "abc-restroom-db", "database_id": "51391d36-fab9-4028-b5ae-26990a1f9c3d" }
  ],
  /* Policies & Procedures: the original PDF / Word files (docs/FEATURE-policies.md). The deploy creates the bucket if it is missing. */
  "r2_buckets": [ { "binding": "FILES", "bucket_name": "abc-hub-files" } ],
  "services": [
    { "binding": "INCIDENTS", "service": "abc-incident-system" },
    { "binding": "RESTROOM", "service": "abc-restroom-report" },
    { "binding": "CLEANER", "service": "abcv-admin-access" },
    { "binding": "FOOTFALL", "service": "footfall-hub" }
  ],
  /* Mail relay (Google Apps Script). The URL is not secret, so it lives here and survives every deploy.
     MAIL_RELAY_KEY stays a Secret in the Cloudflare dashboard — never put it in this file. */
  "vars": {
    "MAIL_RELAY_URL": "https://script.google.com/macros/s/AKfycbwXyT6w5JgPIaW3XX-XbKovyBY1FADZ79wC84JduLHgWndNpgp_UCaB-4KHkzHPo9NiaA/exec"
  },
  "vars": {
    "CLEANER_SHEET_URL": "https://script.google.com/macros/s/AKfycbyTIgrRoCRLi2WO53CPuUwKoEvlOLTZK48To9cFUWKygnS3-8X17vRO0RsvF4QqF4xMmQ/exec",
    "MAIL_RELAY_URL": "https://script.google.com/macros/s/AKfycbwXyT6w5JgPIaW3XX-XbKovyBY1FADZ79wC84JduLHgWndNpgp_UCaB-4KHkzHPo9NiaA/exec"
  },
  /* Hub Assistant (docs/FEATURE-ai.md): Cloudflare Workers AI — free daily allowance, no API key, no card */
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/2 * * * *"] },
  /* PAGER: Emergency Alert repeats · PHONE: Hub Phone call signalling (docs/FEATURE-hub-phone.md) */
  "durable_objects": { "bindings": [ { "name": "PAGER", "class_name": "EmergencyPager" }, { "name": "PHONE", "class_name": "PhoneHub" } ] },
  "migrations": [ { "tag": "v1-emergency-pager", "new_sqlite_classes": ["EmergencyPager"] }, { "tag": "v2-hub-phone", "new_sqlite_classes": ["PhoneHub"] } ]
}

